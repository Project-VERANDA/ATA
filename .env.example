# ============================================================================
# Dialogue Anonymizer Configuration Template
# Copy to .env and customize: cp .env.example .env
# ============================================================================

# WORKSPACE
CURRENT_DIR=/app
MODEL_DIR=$CURRENT_DIR/pipeline/model

# API Keys
CHAT_AI_API_KEY=your_api_key_here
CHAT_AI_ENDPOINT=https://your-endpoint.com/v1

# TTS
TTS_BACKEND=piper
TTS_ENABLED=true
Piper_Voice_Path=$CURRENT_DIR/pipeline/tts/voices/en_US-amy-medium.onnx

# WhisperX
Whisper_Model_Path=$MODEL_DIR/Systran-faster-whisper-large-v3
Whisper_Device=cuda
Whisper_Compute_Type=float16

# Logging
LOG_LEVEL=INFO

# ============================================================================
# Docker Build Arguments
# ============================================================================
BUILD_WEB=true
DOWNLOAD_MODELS=false

# Proxy settings (optional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Application settings
HUGGINGFACE_TOKEN=
WHISPER_MODEL=large
FRONTEND_HOST=localhost
