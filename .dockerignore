# =============================================================================
# DOCKER-SPECIFIC EXCLUSIONS
# =============================================================================

# Docker build context (don't build other projects into this image)
docker-compose*.yml
docker/
Dockerfile*
.docker/
.dockerignore
docker-compose.override.yml

# Build artifacts not needed in containers
*.deb
*.rpm
*.tar.gz
!requirements.lock.txt

# Development configs
.env.test
.env.dev
.env.local
.env.*.local
.docker_env

# Test files
*_test.py
test_*.py
tests/
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# Build logs
build_logs/
*.log
!logs/.gitkeep

# Documentation not needed in runtime
*.md
!README.md
docs/
*.pdf
*.pptx

# IDE files (already in .gitignore, but add here too)
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# Backup files
*.bak
*.backup
*.old

# Temporary Docker build cache
.tmp/
tmp/
__pycache__/

# Scripts not needed in production
Installer.sh
setup_nginx.sh
ssl_certs/setup_ssl.sh
*.sh
!scripts/*.sh

# HuggingFace cache (downloaded at runtime)
.huggingface/
hf_cache/
transformers_cache/

# Node modules (built separately for frontend)
node_modules/
frontend/node_modules/

# React build output (copied during build)
frontend/dist/
frontend/build/

# Large test datasets
test_data/
sample_audio/
sample_video/
