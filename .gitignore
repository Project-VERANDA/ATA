!pipeline/model/**/.GithubCreateDir
pipeline/models/**
!pipeline/models/**/
!pipeline/models/**/.GithubCreateDir
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# ===== Uploaded/Audio/Sensitive Files =====
uploads/
pipeline/videos

# ===== LARGE FILES (Do not commit) =====
# Audio files from processing
pipeline/uploads
pipeline/audio
pipeline/audios
pipeline/transcripts/
pipeline/anonym
pipeline/annonym/
pipeline/logs/
logs/
pipeline/audios_redacted
pipeline/LLM-Anon/
pipeline/tts/*.wav
pipeline/tts/bin/
pipeline/tts/voices/

#  SSL files
key.pem
cert.pem
ssl_certs/server.key
ssl_certs/.generated_by_ata
ssl_certs/.backups/
ssl_certs/server.crt
ssl_certs/server.key
/etc/letsencrypt/**
config.sh

# Backups
backups/

# Unrelated files
*.csv
TextAnonym.py
pipeline_Test.py
!models_manifest.txt
ModelTraining/*
.ipynb_checkpoints/

# Log files
pipeline/anon_session_*

# Python cache
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# Environment files
.env
.venv/
*.egg-info/
dist/
build/
*.part

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
.tmp/

